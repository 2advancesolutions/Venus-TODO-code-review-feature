{
  /**
   * TypeScript Configuration for Node.js/Build tools
   * 
   * This configuration is specifically for Node.js files and build tools
   * like Vite configuration. It's separate from the main application
   * TypeScript configuration to allow different compiler options.
   * 
   * @see https://www.typescriptlang.org/docs/handbook/project-references.html
   */
  
  "compilerOptions": {
    /**
     * Enable project references
     * Allows TypeScript to build projects incrementally
     * @see https://www.typescriptlang.org/docs/handbook/project-references.html
     */
    "composite": true,
    
    /**
     * Skip type checking of declaration files
     * Improves build performance by skipping .d.ts files
     */
    "skipLibCheck": true,
    
    /**
     * Module system
     * Use ESNext for modern module system support
     */
    "module": "ESNext",
    
    /**
     * Module resolution strategy
     * Use bundler resolution for better compatibility with build tools
     */
    "moduleResolution": "bundler",
    
    /**
     * Allow synthetic default imports
     * Enables interoperability between CommonJS and ES modules
     */
    "allowSyntheticDefaultImports": true
  },
  
  /**
   * Files to include in compilation
   * Only includes the Vite configuration file
   */
  "include": ["vite.config.ts"]
}